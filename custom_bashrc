# ~/.bashrc: executed by bash(1) for non-login shells.

# ============================================================================
# INTERACTIVE SHELL CHECK
# ============================================================================
case $- in
    *i*) ;;
      *) return;;
esac

# ============================================================================
# HISTORY CONFIGURATION
# ============================================================================
HISTCONTROL=ignoreboth
shopt -s histappend
HISTSIZE=1000
HISTFILESIZE=2000

# ============================================================================
# SHELL OPTIONS
# ============================================================================
shopt -s checkwinsize
# shopt -s globstar  # Uncomment for recursive globbing with **

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================
parse_git_branch() {
  git branch 2>/dev/null | sed -n 's/^\* \(.*\)/ (\1)/p'
}

# ============================================================================
# ENVIRONMENT VARIABLES
# ============================================================================
export EDITOR=micro
export LANG=en_US.UTF-8

# Custom directory shortcuts (adjusted paths for Linux VM)
MAIN_WORK="/home/ubuntu/main_work"
TRASH="$HOME/.Trash/"
export MAIN_WORK TRASH

# ============================================================================
# PROMPT CONFIGURATION
# ============================================================================
c_reset='\[\e[0m\]'
c_green='\[\e[32m\]'   # neon green for device and username
c_purple='\[\e[35m\]'  # purple (same as ls directory color)

PS1="${c_green}\h${c_reset}:${c_purple}\W${c_reset} ${c_green}\u${c_reset}\$ "

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# ============================================================================
# COLOR SUPPORT FOR LS AND GREP
# ============================================================================
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"

    # Custom LS_COLORS: directories in purple (35), media files in default (00)
    export LS_COLORS="${LS_COLORS:+${LS_COLORS}:}di=35:*.png=00:*.jpg=00:*.jpeg=00:*.gif=00:*.mp4=00:*.mov=00"

    alias ls='ls --color=auto'
    alias ll='ls -alF --color=auto'
    alias la='ls -A --color=auto'
    alias l='ls -CF --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
else
    # Fallback without color
    alias ll='ls -alF'
    alias la='ls -A'
    alias l='ls -CF'
fi

# ============================================================================
# ADDITIONAL ALIASES
# ============================================================================
alias tree='tree -C'

# Add an "alert" alias for long running commands. Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# ============================================================================
# EXTERNAL CONFIGURATION FILES
# ============================================================================
# Load bash aliases if available
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# Enable programmable completion features
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# ============================================================================
# PATH CONFIGURATION
# ============================================================================
export PATH="/home/ubuntu/main_work/homebrew/bin:/home/ubuntu/main_work:$PATH"

# ============================================================================
# HOMEBREW CONFIGURATION
# ============================================================================
if [ -f "/home/ubuntu/main_work/homebrew/bin/brew" ]; then
    eval "$(/home/ubuntu/main_work/homebrew/bin/brew shellenv)"
fi

# ============================================================================
# NVM CONFIGURATION (if installed)
# ============================================================================
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# ============================================================================
# CONDA INITIALIZATION
# ============================================================================
# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
if [ -f "/home/ubuntu/main_work/miniconda3/bin/conda" ]; then
    __conda_setup="$('/home/ubuntu/main_work/miniconda3/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "/home/ubuntu/main_work/miniconda3/etc/profile.d/conda.sh" ]; then
            . "/home/ubuntu/main_work/miniconda3/etc/profile.d/conda.sh"
        else
            export PATH="/home/ubuntu/main_work/miniconda3/bin:$PATH"
        fi
    fi
    unset __conda_setup
fi
# <<< conda initialize
